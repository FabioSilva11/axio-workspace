<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skill_field_name"
            android:textColor="@color/chat_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_skill_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_outline_edittext"
            android:hint="@string/skill_field_name_hint"
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="@color/chat_text_primary"
            android:textColorHint="@color/chat_text_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/skill_field_trigger"
            android:textColor="@color/chat_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_skill_trigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_outline_edittext"
            android:hint="@string/skill_field_trigger_hint"
            android:inputType="text|textCapSentences"
            android:maxLines="2"
            android:padding="12dp"
            android:textColor="@color/chat_text_primary"
            android:textColorHint="@color/chat_text_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/skill_field_content"
            android:textColor="@color/chat_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_skill_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_outline_edittext"
            android:gravity="top|start"
            android:hint="@string/skill_field_content_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="6"
            android:padding="12dp"
            android:textColor="@color/chat_text_primary"
            android:textColorHint="@color/chat_text_hint"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
