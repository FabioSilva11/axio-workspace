<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resource_page_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp"
        android:paddingBottom="96dp" />

    <LinearLayout
        android:id="@+id/resource_page_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/resource_page_empty_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.55"
            android:contentDescription="@null"
            android:tint="@color/chat_text_secondary" />

        <TextView
            android:id="@+id/resource_page_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/chat_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
