<?xml version="1.0" encoding="utf-8"?>
<!--
  TLS é obrigatório por padrão (cleartextTrafficPermitted="false").

  Exceções localhost: provedores locais (Ollama, vLLM, LM Studio) rodam em
  http://127.0.0.1 e http://10.0.2.2 (emulador apontando para o host).
  Nenhum outro domínio aceita HTTP puro; para depurar com proxy (Charles,
  Fiddler), instale o certificado do proxy como CA do usuário no aparelho —
  os anchors de usuário continuam confiáveis de propósito.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- IP do PC de desenvolvimento nesta rede Wi-Fi. Remova após os testes. -->
        <domain includeSubdomains="true">192.168.1.68</domain>
    </domain-config>
</network-security-config>
