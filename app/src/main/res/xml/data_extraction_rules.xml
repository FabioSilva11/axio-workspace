<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de extração de dados (Android 13+): nenhum backup em nuvem ou
  transferência device-to-device. Rede de segurança defensiva caso
  allowBackup seja reativado no futuro.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ia_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ia_settings.xml" />
    </device-transfer>
</data-extraction-rules>
